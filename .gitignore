
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin

# ...except the kernel's test runner. The rule above exists because s&box regenerates its own
# csproj files; this one is hand-written and has to be in the repo for `dotnet run` to work.
!Effigy.Tests/Effigy.Tests.csproj
!tools/iconsheet/IconSheet.csproj
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Halo MCC mount work - unrelated to Marionette, and ships GPL-3.0 binaries.
# Kept on disk, kept out of the repo.
Editor/HaloMount/

# Stray kernel test output at the repo root. Effigy.Tests/out/ is deliberately
# TRACKED — its sample OBJs are the reference the suite is read against.
/out/

# Halo MCC extraction — same policy as Editor/HaloMount above. These are ripped game
# assets and a probe that links GPL-3.0 Reclaimer binaries. Kept on disk, kept out of the repo.
Tools/HaloProbe/
Assets/models/halo/
Assets/materials/halo/

# Whatever Effigy last exported while it was being tested — untitled.dmx and friends. Kept on disk
# because the next export overwrites them anyway and having one to open is useful; kept out of the
# repo because they are the output of a click, not a sample anybody reads.
Assets/models/effigy/
kit_sheets/

# Imported map kits (rp_*) — hundreds of MB of third-party content, sourced not authored.
Assets/models/rp_block/
Assets/models/rp_city/
Assets/models/rp_kit/
Assets/models/rp_town/
Assets/materials/rp_kit/

# Tree models and materials — kept on disk, kept out of the public repo.
Assets/models/trees/
Assets/materials/trees/
Effigy.Tests/out/oak_effigy.*
Effigy.Tests/out/pine_tree.*
Effigy.Tests/out/bark_oak.*
Effigy.Tests/out/leaf_oak.*

# Personal / unrelated — kept on disk, kept out of the repo.
.omp/
Code/TamagotchiTeardownKit.cs
tools/tama_gen.py
Assets/models/tamagotchi/
Assets/materials/tamagotchi/
Editor/Pipeline/
Assets/work.effigy
Assets/materials/diner/_rough_probe.vmat

# Blender's own backup copy.
*.blend1

# Python bytecode and the FBX unit probe's scratch output.
tools/__pycache__/
tools/_unit_probe.py
tools/_unit_test_*.fbx

# s&box library working copies (Libraries/pooh.geppetto and friends). The existing
# .sbox/ and .vscode/ rules above contain a slash, so they anchor to the repo root
# and never matched these nested ones. Everything here is generated by the editor or
# local to this machine: .bin/ is the compiled package, .sbox/ holds cloud.db plus a
# project.json full of absolute paths and window layout, .version is stamped by the
# installer.
Libraries/*/.bin/
Libraries/*/.sbox/
Libraries/*/.vscode/
Libraries/*/.version

# Private dev notes and scratch scripts: this repo is public.
docs/
tools/diner_tile_gen.py

# Local scratch assets. Assets/ carries exactly one tracked file - the editor icon - and
# everything else in here is a part studio or a material made while testing. They are not
# library content, and git add -A in tools/ship.sh would otherwise push them into the
# package, the way 46 sample meshes once landed in 367356's.
Assets/materials/
Assets/test/

# Whatever the editor last saved from a New Part / New Scene click. Same policy as the
# scratch assets above: kept on disk because reopening one is useful, kept out of the
# repo because git add -A in tools/ship.sh would push them into the package.
Assets/untitled.*

# Packages pulled in through the editor's library manager. They are somebody else's
# code, they are restored by the editor rather than by us, and notpointless.chomnr_mcp
# alone is a megabyte of docs and images.
Libraries/
